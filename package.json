{
  "name": "jevit",
  "private": true,
  "version": "1.0.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons": "bun scripts/icons.ts",
    "sync": "bun run build && bunx cap sync",
    "ios": "bun run sync && bunx cap open ios",
    "android": "bun run sync && bunx cap open android",
    "worker:dev": "cd worker && bun run dev",
    "worker:deploy": "cd worker && bun run deploy",
    "capgo:upload": "bun run build && bunx @capgo/cli@latest bundle upload --channel production",
    "store:shots": "bun store/shots.ts",
    "store:apple": "bun store/apple.ts",
    "store:play": "bun store/play.ts",
    "release:android": "bun run sync && cd android && ./gradlew bundleRelease",
    "release:live": "bun scripts/live.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-file-picker": "^8.2.3",
    "@capgo/capacitor-native-navigation": "^8.6.0",
    "@capgo/capacitor-persistent-account": "^8.0.43",
    "@capgo/capacitor-social-login": "^8.5.14",
    "@capgo/capacitor-transitions": "^8.3.1",
    "@capgo/capacitor-updater": "^8.52.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
